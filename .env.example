# NumerAI – Environment Variables
# Copy this to .env (never commit .env to git)

# JSON storage is used automatically — no database setup needed.
# Data is saved to: api/data/db.json (local) or /tmp/vedicnumeroai_db.json (Vercel)

# JWT settings — change JWT_SECRET to a long random string in production!
JWT_SECRET=change_me_to_something_long_and_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — set to your frontend URL in production, e.g. https://yourapp.vercel.app
CORS_ORIGINS=*
